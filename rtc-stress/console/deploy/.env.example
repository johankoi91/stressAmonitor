# One role per physical machine: center or agent.
COMPOSE_PROFILES=center
COMPOSE_PROJECT_NAME=rtc-stress
RTC_IMAGE=rtc-stress-console:0.12.3

# Center only. Existing installations should use their current data directory.
CONSOLE_PORT=8092
CENTER_DATA_DIR=./data/center

# Agent only. Give every agent a unique ID; A belongs to the center.
NODE_ID=B
CENTER_URL=ws://114.132.190.201:8092/ws/agent

# Persistent volume names; keep existing names when migrating.
RUNS_VOLUME=rtc-stress-console-data
NETDATA_LIB_VOLUME=rtc-stress-netdata-lib
NETDATA_CACHE_VOLUME=rtc-stress-netdata-cache

CONTAINER_MEMORY=20g
CONTAINER_PIDS=24000
