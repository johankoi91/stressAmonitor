FROM golang:1.24.13 AS go-toolchain
FROM hub.agoralab.co/rtn-ci/stress:hybrid_tools AS build
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH CGO_ENABLED=1 GOTOOLCHAIN=local
WORKDIR /src
COPY backend/ ./
RUN go build -trimpath -tags agora_sdk -o /out/rtc-sdk-worker ./cmd/rtc-sdk-worker
FROM scratch
COPY --from=build /out/rtc-sdk-worker /rtc-sdk-worker
